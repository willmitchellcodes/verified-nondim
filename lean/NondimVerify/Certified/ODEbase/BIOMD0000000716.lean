      HasDerivAt (fun τ => piGroups Vn (x (τ / monomial (x 0) w)) 2)
        (red_x3 (piGroups Vn (x (τ / monomial (x 0) w)))) τ ∧
      HasDerivAt (fun τ => piGroups Vn (x (τ / monomial (x 0) w)) 3)
        (red_x4 (piGroups Vn (x (τ / monomial (x 0) w)))) τ :=
