import NondimVerify.Reduction
import NondimVerify.Criterion
import NondimVerify.Identifiability
import NondimVerify.Theory

/-!
# `logistic`, reduced by desr 3.0.0, checked against the general theory

Auto-generated by `nondim certify`. Do not edit: change the model and regenerate.

About: dN/dt = rN(1 - N/K). Expect 2 -> 0 parameters: u = N/K, tau = r t.

Variables (Lean index order): 0 = K, 1 = r, 2 = N

Equations:
    dN/dt = N*r*(1 - N/K)

New time: r*t
Invariants (the new variables):
    π 0 = nu0 = N/K
Auxiliary monomials (set to 1): 1/r, K

Reduced equations (ν = the new variable for each state, τ = the new time):
    dnu0/dτ = -nu0**2 + nu0

Parameters: 2 -> 0
-/

-- generated proofs end with `try (...)`: sometimes `simp` has already finished the goal
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unusedSimpArgs false

namespace NondimVerify.Certified.Desr.Logistic

open NondimVerify Matrix

/-! ## The model as data, and a check that the data is the model -/

/-- One list of terms `coefficient * ∏ x_j ^ e_j` per variable; parameters have none. -/
noncomputable def sys : LaurentSystem 3 where
  terms := ![[],
    [],
    [⟨1, ![0, 1, 1]⟩, ⟨(-1), ![-1, 1, 2]⟩]]

/-- The data for `N` is the equation `dN/dt = N*r*(1 - N/K)`. -/
theorem eq_N (K r N : ℝ) :
    sys.rhs 2 ![K, r, N] = (N * r * (1 + ((-1) * N / (K)))) := by
  simp [LaurentSystem.rhs, Term.eval, monomial, sys, Fin.prod_univ_succ]
  try (first | ring1 | (field_simp; ring1) | field_simp)

/-! ## The scalings are symmetries -/

/-- Weights of the variables under each scaling (one scaling per row). -/
def A : Matrix (Fin 2) (Fin 3) ℤ :=
  !![0, -1, 0;
    1, 0, 1]

/-- Weight of time under each scaling. -/
def tau : Fin 2 → ℤ := ![1, 0]

/-- Every term of every equation has the weight of its left-hand side: Lean reads this off
`sys`, with no exponent matrix supplied from outside. -/
theorem symmetry : sys.IsSymmetry A tau := by decide +kernel

/-! ## The change of variables -/

/-- Auxiliary monomials (columns): the reduction sets these to 1. -/
def Vi : Matrix (Fin 3) (Fin 2) ℤ :=
  !![0, 1;
    -1, 0;
    0, 0]

/-- Invariants (columns): the new variables. -/
def Vn : Matrix (Fin 3) (Fin 1) ℤ :=
  !![-1;
    0;
    1]

/-- Top rows of the inverse of `[Vi | Vn]`. -/
def Wu : Matrix (Fin 2) (Fin 3) ℤ :=
  !![0, -1, 0;
    1, 0, 1]

/-- Bottom rows of the inverse of `[Vi | Vn]`: how to recover the variables from the invariants. -/
def Wd : Matrix (Fin 1) (Fin 3) ℤ :=
  !![0, 0, 1]

/-- Left inverse of `A * Vi`, up to the factor `d`. -/
def G : Matrix (Fin 2) (Fin 2) ℤ :=
  !![1, 0;
    0, 1]

/-- `[Vi | Vn]` is unimodular with inverse `[Wu ; Wd]`. -/
theorem unimodular : Vi * Wu + Vn * Wd = 1 := by decide +kernel

/-- Every new variable is invariant under every scaling: it is dimensionless. -/
theorem invariant : A * Vn = 0 := by decide +kernel

/-- The auxiliary monomials can be scaled to any positive values, in particular to 1. -/
theorem auxiliaries_free : G * (A * Vi) = (1 : ℤ) • (1 : Matrix (Fin 2) (Fin 2) ℤ) := by
  decide +kernel

/-- The auxiliary monomials involve parameters only, so they are constant along solutions. -/
theorem auxiliaries_are_parameters : sys.OnlyParams Vi := by decide +kernel

/-! ## The reduced equations

New time: `τ = (r) * t`. Each state `z` gets the new variable `ν = z * (parameters)`.
For each one, a single algebraic identity says that the tool's reduced equation is right.
-/

/-- Exponents of the factor `r` between the old and the new time. -/
def w : Fin 3 → ℤ := ![0, 1, 0]

/-- The time factor involves parameters only, so it is constant along solutions. -/
theorem time_factor_is_parameters : sys.ParamMonomial w := by decide +kernel

/-- Exponents of the factor in `nu0 = N * (1/K)`. -/
def u_N : Fin 3 → ℤ := ![-1, 0, 0]

/-- The new variable for `N` (column 0 of `Vn`) is `N` times that factor... -/
theorem new_N_eq : (fun i => Vn i 0) = u_N + fun j => if j = 2 then 1 else 0 := by
  decide +kernel

/-- ...and the factor involves parameters only. -/
theorem factor_N_is_parameters : sys.ParamMonomial u_N := by decide +kernel

/-- Reduced right-hand side for `N`, as reported by desr 3.0.0: `-nu0**2 + nu0`. -/
noncomputable def red_N (π : Fin 1 → ℝ) : ℝ := ((π 0) + ((-1) * ((π 0) ^ 2)))

/-- `(1/K) * (dN/dt)  =  (r) * (reduced right-hand side at the invariants)`,
at every positive point. -/
theorem reduced_identity_N (z : Fin 3 → ℝ) (hz : ∀ j, 0 < z j) :
    monomial z u_N * sys.rhs 2 z = monomial z w * red_N (piGroups Vn z) := by
  have h0 := (hz 0).ne'
  have h1 := (hz 1).ne'
  have h2 := (hz 2).ne'
  simp [LaurentSystem.rhs, Term.eval, monomial, sys, Fin.prod_univ_succ, piGroups, Vn, u_N, w, red_N]
  try (first | ring1 | (field_simp; ring1) | field_simp)

/-! ## The reduction is correct -/

/-- **Main statement.** Take any solution of the model with positive values and follow the new
variables (the invariants `piGroups Vn`) in the new time `τ = (r) * t`. They satisfy the
reduced equations reported by desr 3.0.0. -/
theorem reduction_correct {x : ℝ → Fin 3 → ℝ} (hx : sys.IsSolution x) (hpos : ∀ s i, 0 < x s i)
    (τ : ℝ) :
      HasDerivAt (fun τ => piGroups Vn (x (τ / monomial (x 0) w)) 0)
        (red_N (piGroups Vn (x (τ / monomial (x 0) w)))) τ :=
  hx.hasDerivAt_newVariable hpos 2 _ u_N w new_N_eq factor_N_is_parameters
      time_factor_is_parameters (fun z => red_N (piGroups Vn z)) reduced_identity_N τ

/-- **The same solution on the cross-section.** Rescaling by a symmetry turns any positive
solution into a solution of the same equations in which every auxiliary monomial equals 1.
The rescaled solution has the same invariants and is determined by them. -/
theorem cross_section {x : ℝ → Fin 3 → ℝ} (hx : sys.IsSolution x) (hpos : ∀ s i, 0 < x s i) :
    ∃ lam : Fin 2 → ℝ, (∀ j, 0 < lam j) ∧
      sys.IsSolution (fun s => scale A lam (x (s / timeFactor lam tau))) ∧
      (∀ s, piGroups Vn (scale A lam (x (s / timeFactor lam tau)))
        = piGroups Vn (x (s / timeFactor lam tau))) ∧
      ∀ s, scale A lam (x (s / timeFactor lam tau))
        = reconstruct Wd (piGroups Vn (scale A lam (x (s / timeFactor lam tau)))) := by
  obtain ⟨lam, hlam, hsol, -, hinv, hsec⟩ :=
    symmetry.reduction_of_parameters Vi Vn Wu Wd unimodular invariant G (1)
      (by decide) auxiliaries_free auxiliaries_are_parameters hx hpos
  exact ⟨lam, hlam, hsol, hinv, hsec⟩

/-! ## Buckingham Pi for this model

Same matrices with time included. Order: K, r, t, N.
-/

/-- All scalings, acting on time and the variables. -/
def Dfull : Matrix (Fin 2) (Fin 4) ℤ :=
  !![0, -1, 1, 0;
    1, 0, 0, 1]

/-- All invariants, including the new time. -/
def Pfull : Matrix (Fin 4) (Fin 2) ℤ :=
  !![0, -1;
    1, 0;
    1, 0;
    0, 1]

/-- Auxiliary columns. -/
def V1full : Matrix (Fin 4) (Fin 2) ℤ :=
  !![0, 1;
    -1, 0;
    0, 0;
    0, 0]

/-- Top rows of the inverse. -/
def W1full : Matrix (Fin 2) (Fin 4) ℤ :=
  !![0, -1, 1, 0;
    1, 0, 0, 1]

/-- Bottom rows of the inverse. -/
def W2full : Matrix (Fin 2) (Fin 4) ℤ :=
  !![0, 0, 1, 0;
    0, 0, 0, 1]

/-- **The invariants are complete.** Any quantity built from time, the states and the
parameters that does not depend on the choice of units is a function of the invariants. -/
theorem invariants_complete {α : Type} (f : (Fin 4 → ℝ) → α) (hf : UnitInvariant Dfull f)
    (q q' : Fin 4 → ℝ) (hq : ∀ i, 0 < q i) (hq' : ∀ i, 0 < q' i)
    (h : piGroups Pfull q = piGroups Pfull q') : f q = f q' :=
  buckingham_pi Dfull Pfull
    (spans_kernel_of_certificate Dfull Pfull V1full W1full W2full G (1) (by decide)
      (by decide +kernel) (by decide +kernel) (by decide +kernel))
    f hf q q' hq hq' h

/-! ## No scaling was missed

Cross-check against an exponent matrix derived independently by this package
(rows: time, then the variables).
-/

/-- Exponent matrix: every scaling must kill every column. -/
def Kmat : Matrix (Fin 4) (Fin 2) ℤ :=
  !![1, 1;
    0, -1;
    1, 1;
    0, 1]

/-- `[tau | A]`: the scalings with the weight of time in front. -/
def Afull : Matrix (Fin 2) (Fin 4) ℤ :=
  !![1, 0, -1, 0;
    0, 1, 0, 1]

theorem kills_K : Afull * Kmat = 0 := by decide +kernel

theorem rank_K : Kmat.rank = 2 := by unfold Kmat; eval_rank

/-- 2 independent scalings out of 4 - 2 = 2 possible: none is missing. -/
theorem rank_A : Afull.rank = 2 := by unfold Afull; eval_rank

/-! ## The smallest possible number of parameters

The scalings act on the 2 parameters with rank 2. So 2 parameters can be scaled to 1
(the reduction above does it) and no 3 can: at least 0 parameter(s) remain,
whatever nondimensionalization by scaling is chosen.
-/

/-- Positions of the parameters: K, r. -/
def P : Fin 2 → Fin 3 := ![0, 1]

/-- The parameter columns of `A`. -/
def ParamCols : Matrix (Fin 2) (Fin 2) ℚ :=
  !![0, -1;
    1, 0]

theorem paramCols_eq : (A.submatrix id P).map (Int.castRingHom ℚ) = ParamCols := by
  decide +kernel

theorem rank_paramCols : ParamCols.rank = 2 := by unfold ParamCols; eval_rank

/-- **No 3 distinct parameters can all be scaled to 1** (for every positive choice of
their values). Together with the reduction above this fixes the minimal parameter count. -/
theorem cannot_remove_more (S : Fin 3 → Fin 2) (hS : Function.Injective S) :
    ¬ ∀ c : Fin 3 → ℝ, (∀ i, 0 < c i) →
        ∃ lam : Fin 2 → ℝ, (∀ j, 0 < lam j) ∧ ∀ i, scale A lam c (P (S i)) = 1 :=
  not_normalizable_of_rank_lt A P S (Function.Injective.comp (by decide) hS)
    (by rw [paramCols_eq, rank_paramCols]; omega)

end NondimVerify.Certified.Desr.Logistic
